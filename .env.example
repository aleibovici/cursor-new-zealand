# Public site URL for sitemap, Open Graph, and JSON-LD (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://cursornewzealand.co.nz

# Credits registration (Upstash Redis via Vercel Storage → KV)
# Created when you run: vercel install upstash/upstash-kv
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Password for /credits/admin (organizer dashboard)
ADMIN_PASSWORD=
