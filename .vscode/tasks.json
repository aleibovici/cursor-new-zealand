{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "dev",
			"type": "shell",
			"command": "pnpm dev",
			"isBackground": true,
			"problemMatcher": {
				"owner": "nextjs",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*",
					"endsPattern": "Ready in|Local:"
				}
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "verify",
			"type": "shell",
			"command": "pnpm verify",
			"group": "test"
		},
		{
			"label": "format",
			"type": "shell",
			"command": "pnpm format",
			"group": "none"
		}
	]
}
